---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
const profiles = [
  { label: 'GitHub', href: site.social.github, detail: '@rmems' },
  { label: 'LinkedIn', href: site.social.linkedin, detail: 'Raul Cardenas Montoya' },
  { label: 'Hugging Face', href: site.social.huggingface, detail: '@rmems' },
  { label: 'X', href: site.social.x, detail: '@KeepOnSpiking' },
  { label: 'Instagram', href: site.social.instagram, detail: '@KeepOnSpiking' },
  { label: 'Threads', href: site.social.threads, detail: '@KeepOnSpiking' },
  { label: 'crates.io', href: site.social.cratesio, detail: 'rmems' },
];
const hasPublicEmail = Boolean(site.email);
---
<BaseLayout title="Contact" description="Email and public profiles. Open to junior and new-grad AI engineering roles, and to relocating."><section class="page-intro compact" aria-labelledby="contact-title"><p class="eyebrow">Contact</p><h1 id="contact-title">Email me.</h1><p>Email is the fastest way to reach me. I'm open to junior and new-grad AI engineering roles, and to relocating. My <a href={site.resumePath}>résumé is a one-page PDF</a>.</p></section><section class="contact-panel" aria-label="Contact links">{hasPublicEmail && <a href={`mailto:${site.email}`}><span>Email</span><strong>{site.email}</strong><span aria-hidden="true">↗</span></a>}{profiles.map((profile) => <a href={profile.href} target="_blank" rel="noreferrer"><span>{profile.label}</span><strong>{profile.detail}</strong><span aria-hidden="true">↗</span></a>)}</section></BaseLayout>
