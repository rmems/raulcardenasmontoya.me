---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeuromorphicDemo from '../components/NeuromorphicDemo.astro';
import HomeProjectCard from '../components/home/HomeProjectCard.astro';
import SectionMarker from '../components/home/SectionMarker.astro';
import SpikeDivider from '../components/home/SpikeDivider.astro';
import SpikeGlyph from '../components/home/SpikeGlyph.astro';
import { loadSiteCounts } from '../artifacts/counts';
import { labs } from '../data/labs';
import { liveCrateLayers } from '../data/live-runtime';
import { projects } from '../data/projects';
import { site } from '../data/site';
import '../styles/home-lab.css';

// mockup/home-lab-direction — local mockup of the homepage redesign.
// Every number on this page comes from a dated snapshot (src/artifacts/counts.ts).
const counts = await loadSiteCounts();
const n = (value: number) => value.toLocaleString('en-US');
const proof = [
  { value: counts.crates, label: 'published crates', href: site.social.cratesio, external: true, dated: counts.cratesAsOf },
  { value: counts.datasets, label: 'datasets', href: site.social.huggingface, external: true, dated: counts.datasetsAsOf },
  { value: counts.mergedPrs, label: 'merged upstream PRs', href: '/artifacts/#upstream', external: false, dated: counts.mergedPrsVerifiedAt },
];
const proofAsOf = [...new Set(proof.map((item) => item.dated))].join(' / ');

// Card copy: each outcome is a shortened line from the project's own summary
// in src/data/projects.ts; metrics are snapshot-backed counts only.
const cards: Record<string, { outcome: string; metrics: { value: string; label: string }[]; strip: 'crate-stack' | 'engram' | 'tbd' }> = {
  'neuromorphic-crate-stack': {
    outcome: 'Small Rust crates for spiking neural networks, one concern per repository.',
    metrics: [
      { value: n(counts.crates), label: 'crates on crates.io' },
      { value: n(counts.cratesTotalDownloads), label: 'total downloads' },
    ],
    strip: 'crate-stack',
  },
  'engram-parser': {
    outcome: 'One format-independent Rust API for GGUF and Safetensors checkpoints.',
    metrics: [
      { value: counts.engramParserVersion, label: 'on crates.io' },
      { value: n(counts.engramParserDownloads), label: 'downloads' },
    ],
    strip: 'engram',
  },
  'synthetic-factory': {
    outcome: 'Deterministic synthetic engineering data with inspectable generation paths.',
    metrics: [{ value: n(counts.factoryDatasets), label: 'public datasets' }],
    strip: 'tbd',
  },
  'agoge-forger': {
    outcome: 'Recorded run: the SFT gain was formatting, not capability.',
    metrics: [],
    strip: 'tbd',
  },
  'nir-rs': {
    outcome: 'Typed NIR graphs in pure Rust, with HDF5 that follows the official Python wire format.',
    metrics: [
      { value: counts.nirVersion, label: 'on crates.io' },
      { value: n(counts.nirDownloads), label: 'downloads' },
    ],
    strip: 'tbd',
  },
  'ship-of-theseus-workstation': {
    outcome: 'An AI/HPC research node and self-hosted engineering environment.',
    metrics: [],
    strip: 'tbd',
  },
};
// The two cards with real visuals lead.
const order = ['neuromorphic-crate-stack', 'engram-parser'];
const featured = projects
  .filter((project) => project.featured && cards[project.slug])
  .sort((a, b) => (order.indexOf(a.slug) + 1 || 99) - (order.indexOf(b.slug) + 1 || 99));
---
<BaseLayout preloadSerif description={`Rust and Python infrastructure for agentic systems, synthetic data, and model evaluation: ${counts.crates} published Rust crates, ${counts.datasets} Hugging Face datasets, and a spiking-network demo that runs in your browser.`}>
  <div class="home-lab">
    <NeuromorphicDemo compact>
      <div class="hero-heading" slot="heading">
        <p class="hero-name">{site.fullName}</p>
        <p class="hero-kicker"><SpikeGlyph />AI Engineer</p>
      </div>
      <h1 id="hero-title">I build infrastructure for <em>agentic</em> systems, synthetic data, and model evaluation.</h1>
      <p class="hero-positioning">AI Engineer building ML infrastructure in Rust and Python.</p>
      <p class="hero-availability"><span class="availability-dot" aria-hidden="true"></span>Open to internships and full-time roles, and I can start now. <span class="hero-place">Austin metropolitan area · open to relocation</span></p>
      <div class="hero-actions"><a class="button button-primary" href={site.resumePath}>Résumé (PDF) <span aria-hidden="true">↓</span></a><a class="button button-secondary" href="/contact/">Contact <span aria-hidden="true">→</span></a></div>
    </NeuromorphicDemo>

    <p class="proof-bar" aria-label="Proof points">
      {proof.map((item, index) => <>{index > 0 ? <span class="proof-sep" aria-hidden="true">·</span> : null}<a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined}><strong>{item.value}</strong> {item.label}</a></>)}
      <span class="proof-dated">as of {proofAsOf}</span>
    </p>

    <section class="home-section home-work" aria-labelledby="work-title">
      <div class="home-section-head">
        <SectionMarker number="01" label="Work" />
        <h2 id="work-title">Projects with a systems spine.</h2>
        <a class="text-link" href="/work/">All work <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-grid">
        {featured.map((project) => <HomeProjectCard project={project} {...cards[project.slug]} />)}
      </div>
    </section>

    <section class="home-why" aria-labelledby="why-title">
      <div class="home-why-inner">
        <figure class="home-why-portrait"><img src="/assets/raul-cardenas-montoya-home-512.jpg" srcset="/assets/raul-cardenas-montoya-home-256.jpg 256w, /assets/raul-cardenas-montoya-home-512.jpg 512w" sizes="(max-width: 680px) 8rem, 12rem" width="512" height="512" alt="Raul Cardenas Montoya" loading="lazy" decoding="async" /></figure>
        <div>
          <SectionMarker number="02" label="About" />
          <h2 id="why-title">Why I build <em>AI.</em></h2>
          <blockquote class="home-why-quote">
            <p>Working with AI coding agents showed me that writing code isn't the hard part. Knowing whether the code is correct is, and that still takes a person who checks it.</p>
            <p>I build AI to help people, not replace them.</p>
          </blockquote>
          <p class="home-why-links"><a class="text-link" href="/about/">Read the full story <span aria-hidden="true">→</span></a><a class="text-link" href="/manifesto/">The manifesto <span aria-hidden="true">→</span></a></p>
        </div>
      </div>
    </section>

    <section class="home-section home-labs" aria-labelledby="labs-title">
      <div class="home-section-head">
        <SectionMarker number="03" label="Labs" />
        <h2 id="labs-title">Run it in the browser.</h2>
        <a class="text-link" href="/labs/">All labs <span aria-hidden="true">→</span></a>
      </div>
      <ul class="home-lab-list">
        <li><a href="/labs/#how-the-demo-works">How the homepage demo works</a><span class="home-lab-tags">{liveCrateLayers.map((layer) => layer.name).join(' · ')}</span></li>
        {labs.map((lab) => <li><a href={lab.href}>{lab.title}</a><span class="home-lab-tags">{lab.crates.join(' · ')}</span></li>)}
      </ul>
    </section>

    <SpikeDivider />

    <section class="home-section home-direction" aria-labelledby="direction-title">
      <SectionMarker number="04" label="Direction" />
      <h2 id="direction-title">Compute that works like a brain, with receipts.</h2>
      <p>Building toward the stars, one traceable step at a time. Designing engineering workflows that preserve their inputs, decisions, and evidence—while continuing to explore the boundary between efficient compute and brain-inspired architectures.</p>
    </section>
  </div>
</BaseLayout>
