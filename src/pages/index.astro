---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeuromorphicDemo from '../components/NeuromorphicDemo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { loadSiteCounts } from '../artifacts/counts';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { upstreamPrs } from '../artifacts/upstream';

// Every number on this page comes from a dated snapshot (src/artifacts/counts.ts).
const counts = await loadSiteCounts();
const stats = [
  { value: counts.crates, label: 'published Rust crates', dated: `as of ${counts.cratesAsOf}`, href: site.social.cratesio, external: true },
  { value: counts.datasets, label: 'Hugging Face datasets', dated: `as of ${counts.datasetsAsOf}`, href: site.social.huggingface, external: true },
  { value: counts.mergedPrs, label: 'merged upstream pull requests', dated: `verified ${counts.mergedPrsVerifiedAt}`, href: '/artifacts/#upstream', external: false },
];
// The upstream projects behind the merged-PR count, taken from the same snapshot.
const upstreamRepos = [...upstreamPrs.reduce((acc, pr) => acc.set(pr.repo, (acc.get(pr.repo) ?? 0) + 1), new Map<string, number>())].map(([repo, merged]) => ({ repo, name: repo.split('/')[1], href: `https://github.com/${repo}`, merged }));
---
<BaseLayout preloadSerif description={`Rust and Python infrastructure for agentic systems, synthetic data, and model evaluation: ${counts.crates} published Rust crates, ${counts.datasets} Hugging Face datasets, and a spiking-network demo that runs in your browser.`}>
  <NeuromorphicDemo>
    <div class="hero-heading" slot="heading"><p class="eyebrow">Raul Cardenas Montoya · AI Engineer</p><p class="hero-coordinate">San Marcos, TX · open to relocation</p></div>
    <h1 id="hero-title">I build infrastructure for <em>agentic systems</em>, synthetic data, and model evaluation.</h1>
    <p class="hero-copy">AI Engineer building ML infrastructure in Rust and Python. I'm finishing a B.S. in AI Engineering at WGU (expected September 2027).</p>
    <p class="hero-roles">Looking for: AI Engineer (intern or junior) · ML Infrastructure Engineer (model evaluation and synthetic data)</p>
    <p class="hero-availability">Open to internships and full-time roles, and I can start now.</p>
    <div class="hero-actions"><a class="button button-primary" href={site.resumePath}>Résumé (PDF) <span aria-hidden="true">↓</span></a><a class="button button-secondary" href={`mailto:${site.email}`}>Email me <span aria-hidden="true">↗</span></a><a class="button button-secondary" href={site.social.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a class="button button-secondary" href={site.social.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="/work/">Selected work <span aria-hidden="true">→</span></a></div>
    <ul class="hero-stats" aria-label="Proof points">{stats.map((stat) => <li><a href={stat.href} target={stat.external ? '_blank' : undefined} rel={stat.external ? 'noreferrer' : undefined}><strong>{stat.value}</strong><span>{stat.label}</span><small>{stat.dated}</small></a></li>)}</ul>
    <p class="hero-upstream">Merged upstream into {upstreamRepos.map((repo, index) => <>{index > 0 ? ' · ' : ''}<a href={repo.href} target="_blank" rel="noreferrer">{repo.name}</a> ({`${repo.merged} ${repo.merged === 1 ? 'PR' : 'PRs'}`})</>)}.</p>
    <p class="hero-skills">Skills: Rust, Python, Julia, PyTorch, TRL, PEFT, WebAssembly, GGUF, Safetensors, NIR, Linux.</p>
  </NeuromorphicDemo>
  <section class="section featured-section" aria-labelledby="featured-title"><div class="section-heading"><p class="eyebrow">Selected work</p><h2 id="featured-title">Projects with a systems spine.</h2><a class="text-link" href="/work/">View the portfolio <span aria-hidden="true">→</span></a></div><div class="project-grid">{projects.filter((project) => project.featured).map((project, index) => <ProjectCard project={project} index={index} counts={counts} />)}</div></section>
  <section class="home-about" aria-labelledby="home-about-title"><figure><picture><source type="image/webp" srcset="/assets/raul-cardenas-montoya-256.webp 256w, /assets/raul-cardenas-montoya-512.webp 512w" sizes="(max-width: 680px) 11rem, 14rem" /><img src="/assets/raul-cardenas-montoya-512.jpg" srcset="/assets/raul-cardenas-montoya-256.jpg 256w, /assets/raul-cardenas-montoya-512.jpg 512w" sizes="(max-width: 680px) 11rem, 14rem" width="512" height="512" alt="Raul Cardenas Montoya" loading="lazy" decoding="async" /></picture></figure><div><p class="eyebrow">About</p><h2 id="home-about-title">Why I build AI.</h2><p>I didn't take a straight path here: computer science, then electrical engineering, then back to AI. Working heavily with AI coding agents taught me that the bottleneck isn't writing code, it's knowing whether the code is right.</p><p>That judgment still takes people, so I build AI to help people, not replace them. After losing a large amount of code once, I publish everything: it all lives on GitHub and crates.io, with dated snapshots and pinned commits behind every number on this page.</p><p class="home-about-links"><a class="text-link" href="/about/">More about me <span aria-hidden="true">→</span></a><a class="text-link" href="/manifesto/">Read the manifesto <span aria-hidden="true">→</span></a></p></div></section>
  <section class="focus-band" aria-labelledby="focus-title"><div><p class="eyebrow">Direction</p><h2 id="focus-title">Compute that works like a brain, with receipts.</h2></div><p>Building toward the stars, one traceable step at a time. Designing engineering workflows that preserve their inputs, decisions, and evidence—while continuing to explore the boundary between efficient compute and brain-inspired architectures.</p></section>
</BaseLayout>
