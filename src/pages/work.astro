---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fillCounts, loadSiteCounts } from '../artifacts/counts';
import { loadGithubIndex } from '../artifacts/github';
import { projects } from '../data/projects';

const [counts, github] = await Promise.all([loadSiteCounts(), loadGithubIndex()]);
const githubSourceNote =
  github.source === 'snapshot'
    ? github.fallbackReason === 'skipped'
      ? ' (from the committed snapshot; the live fetch was skipped for this build)'
      : ' (from the committed snapshot; the GitHub API was unreachable at build time)'
    : '';
---

<BaseLayout preloadSerif title="Work" description="Selected AI/ML systems work, research infrastructure, and ongoing technical explorations.">
  <section class="page-intro work-intro" aria-labelledby="work-title">
    <p class="eyebrow">Selected work · {String(projects.length).padStart(2, '0')}</p>
    <h1 id="work-title">Systems work,<br /><em>shown in context.</em></h1>
    <p>Each brief leads with its public evidence, states its status and why it matters, the questions in view, and the areas it covers. Numbers come from the dated snapshots; where the linked repository already shows a result, the brief says what has shipped.</p>
    <img class="page-photo" src="/assets/raul-cardenas-montoya-strip-2-512.jpg" srcset="/assets/raul-cardenas-montoya-strip-2-256.jpg 256w, /assets/raul-cardenas-montoya-strip-2-512.jpg 512w" sizes="8rem" width="512" height="512" alt="Raul in a red cap and yellow shirt, outdoors" loading="lazy" decoding="async" />
  </section>

  <nav class="work-index" aria-label="On this page">
    <p class="eyebrow">Project index</p>
    <ol>
      {projects.map((project, index) => (
        <li><a href={`#${project.slug}`}><span>{String(index + 1).padStart(2, '0')}</span>{project.name}</a></li>
      ))}
    </ol>
  </nav>

  <div class="case-study-list">
    {projects.map((project, index) => (
      <article class="case-study" id={project.slug}>
        <header class="case-study-header">
          <div>
            <p class="eyebrow">{String(index + 1).padStart(2, '0')} · {project.category}</p>
            <h2>{project.name}</h2>
          </div>
          <span class="status"><i aria-hidden="true"></i>{project.status}</span>
        </header>
        <div class="case-study-body">
          <p class="case-study-summary">{project.summary}</p>
          <div class="case-study-detail">
            {project.evidence ? (
              <section class="case-study-shipped" aria-labelledby={`${project.slug}-evidence`}>
                <p class="detail-label" id={`${project.slug}-evidence`}>Evidence</p>
                <p>{fillCounts(project.evidence, counts)}</p>
              </section>
            ) : null}
            {project.shipped ? (
              <section class="case-study-shipped" aria-labelledby={`${project.slug}-shipped`}>
                <p class="detail-label" id={`${project.slug}-shipped`}>{project.shippedLabel ?? 'Shipped'}</p>
                <p>{fillCounts(project.shipped, counts)}</p>
              </section>
            ) : null}
            {project.next ? (
              <section class="case-study-shipped" aria-labelledby={`${project.slug}-next`}>
                <p class="detail-label" id={`${project.slug}-next`}>Next milestone</p>
                <p>{fillCounts(project.next, counts)}</p>
              </section>
            ) : null}
            {project.whyItMatters ? (
              <section class="case-study-shipped" aria-labelledby={`${project.slug}-why`}>
                <p class="detail-label" id={`${project.slug}-why`}>Why it matters</p>
                <p>{project.whyItMatters}</p>
              </section>
            ) : null}
            <section aria-labelledby={`${project.slug}-questions`}>
              <p class="detail-label" id={`${project.slug}-questions`}>Questions in view</p>
              <ul class="question-list">
                {project.questions.map((question) => <li>{question}</li>)}
              </ul>
            </section>
            <section aria-labelledby={`${project.slug}-areas`}>
              <p class="detail-label" id={`${project.slug}-areas`}>Working areas</p>
              <ul class="technology-list case-study-technologies">
                {project.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
            </section>
          </div>
          {project.links.map((link) => <a class="project-external-link" href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}
        </div>
      </article>
    ))}
  </div>

  <section class="section work-github" id="also-on-github" aria-labelledby="work-github-title" data-github-source={github.source}>
    <p class="eyebrow">GitHub · as of {github.asOf}</p>
    <h2 id="work-github-title">Also on GitHub</h2>
    <p class="artifacts-note">{github.repos.length} more public repositories across {github.owners.join(' and ')}, as of {github.asOf}{githubSourceNote}. Each line is the repository's own GitHub description, its main language and the month of its last push. Archived, private and forked repositories, profile repositories and the ones behind the briefs above are left out, and a few are held back until they have results.</p>
    {github.groups.map((group) => (
      <>
        <h3 id={`github-${group.key}`}>{group.title}</h3>
        <ul class="artifact-list repo-list" aria-labelledby={`github-${group.key}`}>
          {group.repos.map((repo) => (
            <li>
              <p class="repo-head"><a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.name}</a>{repo.language ? <span class="repo-meta">{repo.language}</span> : null}{repo.pushed ? <span class="repo-meta">pushed {repo.pushed}</span> : null}</p>
              {repo.description ? <p class="repo-description">{repo.description}</p> : null}
              {repo.note ? <span class="artifact-status">{repo.note}</span> : null}
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>

  <section class="work-principle" aria-labelledby="work-principle-title">
    <p class="eyebrow">Working principle</p>
    <h2 id="work-principle-title">Make the path as inspectable as the result.</h2>
    <p>Across the portfolio, the recurring emphasis is on pinned inputs, executable paths, provenance, validation, and documentation that remains useful when the work changes hands.</p>
  </section>
</BaseLayout>
