---
import goldenText from '../data/plasticity/scripted-session.v1.json?raw';
import { f32FromBits, parsePlasticityGolden } from '../runtime/plasticity-lab';

// A build-time schematic of the plasticity lab's network from its committed
// golden session (src/data/plasticity/, generated by
// tests/plasticity_session.rs): the input channels on the left, the LIF
// neurons on the right, and one line per synapse whose width is that weight
// at the end of the scripted session. `final_weight_bits` is indexed
// `neuron * channels + channel`, as the lab's weight table reads it.
const golden = parsePlasticityGolden(JSON.parse(goldenText));
const channels = golden.network.channels;
const neurons = golden.network.lif_neurons;
const weights = golden.final_weight_bits.map(f32FromBits);
const extent = Math.max(...weights.map(Math.abs), Number.EPSILON);
const width = 340;
const height = 200;
const left = 78;
const right = 262;
const channelY = (channel: number) => 30 + ((height - 60) * channel) / Math.max(channels - 1, 1);
const neuronY = (neuron: number) => 62 + ((height - 124) * neuron) / Math.max(neurons - 1, 1);
const synapses = Array.from({ length: neurons }, (_, neuron) =>
  Array.from({ length: channels }, (_, channel) => ({ neuron, channel, weight: weights[neuron * channels + channel] })),
).flat();
const round = (value: number) => Math.round(value * 100) / 100;
// Pattern A drives channels 0 and 1, pattern B channels 2 and 3 (the lab's own labelling).
const pattern = (channel: number) => (channel < channels / 2 ? 'A' : 'B');
---
<figure class="lab-preview lab-preview-plasticity">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="lab-preview-plasticity-title lab-preview-plasticity-desc">
    <title id="lab-preview-plasticity-title">Preview of the reward-modulated learning network</title>
    <desc id="lab-preview-plasticity-desc">{channels} input channels on the left feed {neurons} LIF neurons on the right through {synapses.length} synapses. Each line's width is that synapse's weight at the end of the committed scripted session, seed {golden.seed}.</desc>
    <g class="lab-preview-synapses">
      {synapses.map((synapse) => (
        <line x1={left} y1={round(channelY(synapse.channel))} x2={right} y2={round(neuronY(synapse.neuron))} stroke-width={round(0.75 + 3.25 * (Math.abs(synapse.weight) / extent))} />
      ))}
    </g>
    <g class="lab-preview-channels">
      {Array.from({ length: channels }, (_, channel) => (
        <g>
          <circle cx={left} cy={round(channelY(channel))} r="7" />
          <text class="lab-preview-label" x={left - 14} y={round(channelY(channel)) + 4} text-anchor="end">ch {channel} · {pattern(channel)}</text>
        </g>
      ))}
    </g>
    <g class="lab-preview-neurons">
      {Array.from({ length: neurons }, (_, neuron) => (
        <g>
          <circle cx={right} cy={round(neuronY(neuron))} r="11" />
          <text class="lab-preview-label" x={right + 18} y={round(neuronY(neuron)) + 4}>LIF {neuron}</text>
        </g>
      ))}
    </g>
  </svg>
  <figcaption>{channels} input channels, {neurons} LIF neurons, {synapses.length} synapses. Line width is each weight at the end of the committed scripted session (seed {golden.seed}), drawn at build time.</figcaption>
</figure>
