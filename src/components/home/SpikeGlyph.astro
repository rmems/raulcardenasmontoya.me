---
// The spike mark: one action potential (rest, depolarise, overshoot,
// undershoot, rest) drawn as a single stroke. Decorative everywhere it is used;
// the text beside it carries the meaning.
const { class: className = '' } = Astro.props as { class?: string };
---
<svg class:list={['spike-glyph', className]} viewBox="0 0 24 16" width="24" height="16" aria-hidden="true" focusable="false"><path d="M0 10.5h7.2l2.1-9 2.6 13.2 1.9-5.4 1.4 1.2H24" /></svg>
