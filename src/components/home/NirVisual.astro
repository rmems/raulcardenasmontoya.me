---
import projectionText from '../../data/nir/lif-readout-example.v1.inspection.json?raw';
// nir-rs visual: the operator chain of the committed NIR example that nir-rs
// parses in the NIR lab, with the crate version from the crates snapshot.
const { version, downloads } = Astro.props as { version: string; downloads: string };
const projection = JSON.parse(projectionText) as { nodes: { name: string; operator: string }[]; edges: { source: string; target: string }[] };
const ops = projection.nodes;
// Row of each node in the three-column grid (must match .nir-chain in
// home-lab.css). A node whose incoming edge comes from an earlier row gets
// a continuation marker instead of the in-row arrow, so no committed edge
// is left undrawn (e.g. lif1 → fc2 crosses the row boundary).
const columns = 3;
const rowOf = new Map(ops.map((op, index) => [op.name, Math.floor(index / columns)]));
const incoming = new Map(projection.edges.map((edge) => [edge.target, edge.source]));
const wraps = (name: string) => {
  const source = incoming.get(name);
  return source !== undefined && rowOf.get(source) !== rowOf.get(name);
};
---
<div class="visual visual--ink visual-nir">
  <p class="visual-version">nir-rs <strong>{version}</strong><span>{downloads} downloads</span></p>
  <ol class="nir-chain" aria-label={`NIR example graph: ${ops.map((op) => op.name).join(' to ')}`}>{ops.map((op) => <li class:list={{ 'nir-wrap': wraps(op.name) }}><span class="nir-name">{op.name}</span><span class="nir-op">{op.operator}</span></li>)}</ol>
  <p class="visual-caption">labs/nir · lif-readout-example.v1</p>
</div>
