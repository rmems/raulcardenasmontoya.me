---
// Ship of Theseus visual: a spec sheet quoted from the repository README's
// "Core compute" table (https://github.com/rmems/Ship-of-Theseus-Workstation).
const rows = [
  ['CPU', 'AMD Ryzen 9 9950X, 16 cores'],
  ['GPU', 'RTX 5080 OC, 16 GB VRAM'],
  ['Memory', '64 GB DDR5-6000, CL30'],
  ['Storage', '2 TB Crucial T700 PCIe 5.0'],
  ['OS', 'Fedora Linux'],
];
---
<div class="visual visual--paper visual-spec">
  <dl>{rows.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}</dl>
  <p class="visual-caption">README · Core compute</p>
</div>
