---
import { auditedBrowserTopology } from '../../runtime/neuromorphic-adapter';
import { edgeStrength, edgeWeightExtent, SITE_TOPOLOGY_PALETTE_DARK, staticMeshGeometry } from '../../runtime/topology-layout';
// Card strip for the neuromorphic crate stack, drawn at build time from the
// same audited synaptic-wiring topology the homepage demo runs: the ring
// layout on the left, and its connectivity as a raster on the right (one row
// per source neuron, one tick per synapse at its target's column).
const topology = auditedBrowserTopology();
const mesh = staticMeshGeometry(topology, SITE_TOPOLOGY_PALETTE_DARK);
const nodeCount = topology.nodeIds.length;
const edgeCount = topology.edgeSources.length;
const extent = edgeWeightExtent(topology.edgeWeights);
const ticks = Array.from({ length: edgeCount }, (_, edge) => ({
  x: topology.edgeTargets[edge],
  y: topology.edgeSources[edge],
  inhibitory: topology.polarities[edge] !== 0,
  opacity: edgeStrength(topology.edgeWeights[edge], extent).toFixed(2),
}));
const nodePath = mesh.nodes.map((node) => `M${node.x} ${node.y}h0`).join('');
---
<div class="card-strip card-strip--plate crate-strip">
  <svg class="crate-strip-ring" viewBox={mesh.viewBox} aria-hidden="true" focusable="false">
    <g fill="none" stroke-width="1" stroke-opacity={mesh.edgeOpacity}>{mesh.edges.map((edge) => <line x1={edge.x1} y1={edge.y1} x2={edge.x2} y2={edge.y2} stroke={edge.stroke} vector-effect="non-scaling-stroke" />)}</g>
    <path d={nodePath} fill="none" stroke={mesh.nodeFill} stroke-width={mesh.nodeSize} stroke-linecap="round" />
  </svg>
  <svg class="crate-strip-raster" viewBox={`0 0 ${nodeCount} ${nodeCount}`} preserveAspectRatio="none" role="img" aria-label={`Connectivity raster of the synaptic-wiring network: ${nodeCount} neurons, ${edgeCount} synapses, one row per source neuron.`}>
    {ticks.map((tick) => <rect class={tick.inhibitory ? 'tick-i' : 'tick-e'} x={tick.x} y={tick.y} width="0.72" height="0.8" fill-opacity={tick.opacity} />)}
  </svg>
  <p class="card-strip-caption">synaptic-wiring · {nodeCount} × {edgeCount} · build-time</p>
</div>
