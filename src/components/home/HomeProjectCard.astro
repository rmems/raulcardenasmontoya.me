---
import type { Project } from '../../data/projects';
import CrateStackStrip from './CrateStackStrip.astro';
import EngramStrip from './EngramStrip.astro';
// Homepage project card (mockup/home-lab-direction): a visual strip, the title,
// a one-line outcome, at most two snapshot-backed metrics, small mono tags, a
// primary "Read the brief" link and a quiet repository link. Regions sit on a
// shared subgrid so every card in a row lines up.
interface Metric { value: string; label: string }
interface Props { project: Project; outcome: string; metrics: Metric[]; strip: 'crate-stack' | 'engram' | 'tbd' }
const { project, outcome, metrics, strip } = Astro.props as Props;
const repository = project.links.find((link) => link.label === 'Repository') ?? project.links[0];
const titleId = `home-card-${project.slug}`;
---
<article class="home-card" aria-labelledby={titleId}>
  {strip === 'crate-stack' ? <CrateStackStrip /> : strip === 'engram' ? <EngramStrip /> : (
    <div class="card-strip card-strip--tbd" aria-hidden="true"><span>visual TBD</span></div>
  )}
  <header>
    <p class="home-card-kicker">{project.category}</p>
    <h3 id={titleId}><a href={`/work/#${project.slug}`}>{project.name}</a></h3>
  </header>
  <p class="home-card-outcome">{outcome}</p>
  {metrics.length > 0 ? (
    <dl class="home-card-metrics">{metrics.slice(0, 2).map((metric) => <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl>
  ) : <div class="home-card-metrics" />}
  <ul class="home-card-tags" aria-label={`${project.name} technologies`}>{project.technologies.slice(0, 3).map((tag) => <li>{tag}</li>)}</ul>
  <footer>
    <a class="home-card-brief" href={`/work/#${project.slug}`}>Read the brief<span class="visually-hidden"> on {project.name}</span> <span aria-hidden="true">→</span></a>
    {repository ? <a class="home-card-repo" href={repository.href} target="_blank" rel="noreferrer">{repository.label}<span class="visually-hidden"> for {project.name} (opens in new tab)</span> <span aria-hidden="true">↗</span></a> : null}
  </footer>
</article>
