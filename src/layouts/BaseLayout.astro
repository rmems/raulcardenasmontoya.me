---
import '../styles/global.css';
import '../styles/polish.css';
import SiteHeader from '../components/SiteHeader.astro';
import { footerLinks, site } from '../data/site';
interface Props { title?: string; description?: string; /** Pages whose heading uses the serif italic preload it, so the headline does not reflow. */ preloadSerif?: boolean; /** Keeps a route out of search results: the 404 page, and anything else that should not rank. */ noindex?: boolean; /** The homepage body flag: the palette and faces are global (#181); this only opts the page into its own scoped CSS. */ theme?: 'signal'; }
const { title, description = site.description, preloadSerif = false, noindex = false, theme } = Astro.props;
const brandTitle = `${site.fullName} — ${site.title}`;
const pageTitle = title ? `${brandTitle} · ${title}` : brandTitle;
const metaDescription = description.startsWith(site.fullName) ? description : `${site.fullName} — ${site.title}. ${description}`;
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  jobTitle: site.title,
  url: new URL('/', Astro.site).href,
  // The Person's image is the profile photo, the same one the social card carries.
  image: new URL('/assets/raul-cardenas-montoya-512.jpg', Astro.site).href,
  description: site.description,
  sameAs: Object.values(site.social),
  ...(site.email ? { email: site.email } : {}),
};
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/assets/social-card.png', Astro.site);
// The card's alt names the same title the JSON-LD and the <title> use, so no metadata source disagrees.
const socialImageAlt = `${site.fullName} — ${site.title}, raulcardenasmontoya.me`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta name="theme-color" content="#f5f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0f" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preloadSerif ? <link rel="preload" href="/fonts/newsreader-italic-latin.woff2" as="font" type="font/woff2" crossorigin /> : null}
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.xHandle} />
    <meta name="twitter:creator" content={site.xHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body class:list={[{ 'theme-signal': theme === 'signal' }]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="scroll-progress-spike" aria-hidden="true"><svg viewBox="0 0 18 12" focusable="false"><path d="M0 2h7l1.5 9 2-10 1.5 5 1-2H18" /></svg></div>
    <div class="page-shell">
      <SiteHeader currentPath={Astro.url.pathname} />
      <main id="main-content"><slot /></main>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {site.fullName}</p>
        <nav aria-label="Contact and profiles"><ul class="footer-links">{footerLinks.map((link) => <li><a href={link.href} aria-label={link.ariaLabel ?? (link.external ? `${link.label} (opens in new tab)` : undefined)} target={link.external ? '_blank' : undefined} rel={link.external ? 'me noopener noreferrer' : undefined}>{link.label}</a></li>)}</ul></nav>
      </footer>
    </div>
    <script is:inline>
      // Unstick the masthead once it wraps: a tall sticky header would cover
      // anchor targets and much of the viewport at large text. The phone CSS
      // already scrolls the header away below 900px; this covers wrapping at
      // wider viewports, which no px- or em-based media query can detect.
      // Rows are counted by vertical overlap (not by distinct tops: brand,
      // nav and pill have different heights even on one line). Guarded like
      // the renderer's observer: without ResizeObserver the header simply
      // stays sticky, as before.
      if (typeof ResizeObserver === 'function') {
        const header = document.querySelector('.site-header');
        if (header) {
          new ResizeObserver(() => {
            const boxes = [...header.children].map((child) => child.getBoundingClientRect());
            boxes.sort((a, b) => a.top - b.top);
            let rows = 0;
            let bottom = -Infinity;
            for (const box of boxes) {
              if (box.top > bottom + 1) {
                rows += 1;
                bottom = box.bottom;
              } else {
                bottom = Math.max(bottom, box.bottom);
              }
            }
            if (rows > 1) header.setAttribute('data-stacked', '');
            else header.removeAttribute('data-stacked');
          }).observe(header);
        }
      }
    </script>
  </body>
</html>
